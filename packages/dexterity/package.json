{
  "name": "dexterity-sdk",
  "version": "0.9.0",
  "description": "Dexterity: quote and route swaps across Charisma and wrapped Bitflow, ALEX, Arkadiko and Velar pools on Stacks.",
  "license": "MIT",
  "author": "rozar",
  "homepage": "https://docs.charisma.rocks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r0zar/charisma.git",
    "directory": "packages/dexterity"
  },
  "keywords": [
    "stacks",
    "dexterity",
    "amm",
    "router",
    "swap",
    "charisma",
    "defi"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/es/index.js",
  "module": "./dist/es/index.js",
  "types": "./dist/es/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/es/index.d.ts",
        "default": "./dist/es/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunchee",
    "dev": "bunchee --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@stacks/blockchain-api-client": "^8.11.5",
    "@stacks/connect": "^8.2.7",
    "@stacks/encryption": "^7.6.0",
    "@stacks/network": "^7.6.0",
    "@stacks/stacks-blockchain-api-types": "^7.14.1",
    "@stacks/transactions": "^7.6.0",
    "@swc/helpers": "^0.5.17"
  },
  "devDependencies": {
    "@modules/discovery": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/polyglot": "workspace:*",
    "@repo/tokens": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.0.14",
    "bunchee": "^6.5.4",
    "eslint": "^9.31.0",
    "happy-dom": "^18.0.1",
    "typescript": "5.8.3",
    "vitest": "^3.1.3"
  }
}
