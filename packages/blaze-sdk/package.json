{
  "name": "blaze-sdk",
  "version": "2.1.0",
  "description": "Blaze: SIP-018 signed intents on Stacks. Sign triggered swaps, verify signed requests, read subnet balances.",
  "license": "MIT",
  "author": "rozar",
  "homepage": "https://docs.charisma.rocks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r0zar/charisma.git",
    "directory": "packages/blaze-sdk"
  },
  "keywords": [
    "stacks",
    "blaze",
    "sip-018",
    "intents",
    "charisma",
    "defi"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/es/index.js",
  "module": "./dist/es/index.js",
  "types": "./dist/es/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/es/index.d.ts",
        "default": "./dist/es/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bunchee",
    "dev": "bunchee --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "script": "node scripts/run.js"
  },
  "dependencies": {
    "@stacks/blockchain-api-client": "^8.11.5",
    "@stacks/connect": "^8.2.7",
    "@stacks/encryption": "^7.6.0",
    "@stacks/network": "^7.6.0",
    "@stacks/stacks-blockchain-api-types": "^7.14.1",
    "@stacks/transactions": "^7.6.0",
    "@swc/helpers": "^0.5.17",
    "partysocket": "^1.0.2",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/polyglot": "workspace:*",
    "@repo/tokens": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.0.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/ws": "^8.5.14",
    "bunchee": "^6.5.4",
    "eslint": "^9.31.0",
    "happy-dom": "^18.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.3",
    "typescript": "5.8.3",
    "vitest": "^3.1.3",
    "ws": "^8.18.0"
  }
}
