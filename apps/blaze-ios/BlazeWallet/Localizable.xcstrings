    "Charisma's balance service sent something Blaze Wallet can't read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Guthabendienst von Charisma hat Daten gesendet, die Blaze Wallet nicht lesen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de saldos de Charisma envió algo que Blaze Wallet no puede leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service de soldes de Charisma a envoyé des données que Blaze Wallet ne peut pas lire."
