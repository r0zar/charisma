    "Every seed phrase and account is removed from this iPhone. Your funds stay safe on the blockchain; you'll need your seed phrases to get back in.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Seed-Phrasen und Konten werden von diesem iPhone entfernt. Dein Guthaben bleibt sicher auf der Blockchain; um wieder Zugang zu erhalten, brauchst du deine Seed-Phrasen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán todas las frases semilla y cuentas de este iPhone. Tus fondos siguen seguros en la blockchain; necesitarás tus frases semilla para volver a entrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les phrases de récupération et tous les comptes seront supprimés de cet iPhone. Vos fonds restent en sécurité sur la blockchain ; pour retrouver l’accès, vous aurez besoin de vos phrases de récupération."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのシードフレーズとアカウントがこの iPhone から削除されます。資金はブロックチェーン上に安全に残りますが、再びアクセスするにはシードフレーズが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 시드 문구와 계정이 이 iPhone에서 제거됩니다. 자금은 블록체인에 안전하게 남아 있으며, 다시 접근하려면 시드 문구가 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as frases de recuperação e contas serão removidas deste iPhone. Seus fundos continuam seguros na blockchain; você vai precisar das suas frases de recuperação para entrar de novo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm kurtarma ifadeleri ve hesaplar bu iPhone'dan kaldırılır. Fonlarınız blok zincirinde güvende kalır; yeniden erişmek için kurtarma ifadelerinize ihtiyacınız olacak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有助记词和账户都将从此 iPhone 上移除。你的资金仍安全地保存在区块链上；你需要凭助记词才能重新访问。"
          }
        }
      }
    },
    "Exactly this amount, nothing else": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genau dieser Betrag, sonst nichts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exactamente esta cantidad, nada más"
          }
        },
        "fr": {
