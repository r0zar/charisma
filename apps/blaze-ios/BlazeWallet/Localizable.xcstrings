    "That account is no longer in this wallet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto ist nicht mehr in dieser Wallet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa cuenta ya no está en esta billetera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte ne fait plus partie de ce portefeuille."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのアカウントはもうこのウォレットにありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 계정은 더 이상 이 지갑에 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa conta não está mais nesta carteira."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O hesap artık bu cüzdanda değil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该账户已不在此钱包中。"
          }
        }
      }
    },
    "That isn't a valid seed phrase: check each word's spelling and that none are missing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist keine gültige Seed-Phrase: Prüfe die Schreibweise jedes Wortes und ob eines fehlt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa no es una frase semilla válida: revisa la ortografía de cada palabra y que no falte ninguna."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce n’est pas une phrase de récupération valide : vérifiez l’orthographe de chaque mot et qu’il n’en manque aucun."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なシードフレーズではありません。各単語のつづりと、抜けている単語がないかを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유효한 시드 문구가 아닙니다. 각 단어의 철자가 맞는지, 빠진 단어가 없는지 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa frase de recuperação não é válida: confira a grafia de cada palavra e se não falta nenhuma."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu geçerli bir kurtarma ifadesi değil: her kelimenin yazımını ve eksik kelime olmadığını kontrol edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是有效的助记词：请检查每个单词的拼写，并确认没有遗漏。"
          }
        }
      }
    },
    "That seed phrase is no longer in this wallet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Seed-Phrase ist nicht mehr in dieser Wallet."
          }
        },
        "es": {
          "stringUnit": {
