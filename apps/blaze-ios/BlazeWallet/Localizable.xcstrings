        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크 수수료를 낼 STX가 부족합니다. 수수료는 %1$@ STX이고 잔액은 %2$@ STX입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
