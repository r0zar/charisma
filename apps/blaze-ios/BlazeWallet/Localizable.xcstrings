          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tienes suficientes STX para la comisión de red: cuesta %@ STX y tienes %@ STX."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
