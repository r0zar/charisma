          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抄下这些单词"
          }
        }
      }
    },
    "You have %@ %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast %1$@ %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "You have %1$@ %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes %@ %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez %1$@ %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残高は %1$@ %2$@ です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잔액은 %1$@ %2$@입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tem %@ %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sizde %1$@ %2$@ var."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的余额为 %1$@ %2$@。"
          }
        }
      }
    },
    "You have no %@ to send yet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast noch kein %@ zum Senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no tienes %@ para enviar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n’avez encore aucun %@ à envoyer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送金できる %@ はまだありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 보낼 수 있는 %@ 잔액이 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ainda não tem %@ para enviar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz gönderebileceğiniz %@ yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你还没有可发送的 %@。"
          }
        }
      }
    },
    "Your %@ is all on Blaze. Move it with Charisma Swap.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein %@ liegt komplett auf Blaze. Verschiebe es mit Charisma Swap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo tu saldo de %@ está en Blaze. Muévelo con Charisma Swap."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre solde %@ est entièrement sur Blaze. Déplacez-le avec Charisma Swap."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はすべて Blaze 上にあります。Charisma Swap で移動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 잔액은 모두 Blaze에 있습니다. Charisma Swap을 사용해 옮기세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo o seu saldo de %@ está no Blaze. Mova-o com Charisma Swap."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bakiyenizin tamamı Blaze'de. Charisma Swap ile taşıyın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 %@ 全部在 Blaze 上。请使用 Charisma Swap 转移。"
          }
        }
      }
    },
    "Your keys stay on this iPhone, behind Face ID.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Schlüssel bleiben auf diesem iPhone, geschützt durch Face ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus claves se quedan en este iPhone, protegidas con Face ID."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos clés restent sur cet iPhone, protégées par Face ID."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秘密鍵はこの iPhone に保管され、Face ID で保護されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키는 이 iPhone에 보관되며 Face ID로 보호됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas chaves ficam neste iPhone, protegidas pelo Face ID."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtarlarınız Face ID korumasıyla bu iPhone'da kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的密钥留在此 iPhone 上，受面容 ID 保护。"
          }
        }
