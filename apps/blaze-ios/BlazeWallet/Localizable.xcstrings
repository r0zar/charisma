    "Not enough STX for the network fee. You can send up to %@ STX.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug STX für die Netzwerkgebühr. Du kannst bis zu %@ STX senden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tienes suficientes STX para la comisión de red. Puedes enviar hasta %@ STX."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas assez de STX pour les frais de réseau. Vous pouvez envoyer jusqu’à %@ STX."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワーク手数料に必要な STX が足りません。最大 %@ STX まで送金できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크 수수료를 낼 STX가 부족합니다. 최대 %@ STX까지 보낼 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "STX insuficiente para a taxa de rede. Você pode enviar até %@ STX."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağ ücreti için yeterli STX yok. En fazla %@ STX gönderebilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "STX 不足以支付网络手续费。你最多可以发送 %@ STX。"
          }
        }
      }
    },
    "Not enough STX for the network fee: it's %@ STX and you have %@ STX.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug STX für die Netzwerkgebühr von %1$@ STX: Du hast %2$@ STX."
          }
        },
