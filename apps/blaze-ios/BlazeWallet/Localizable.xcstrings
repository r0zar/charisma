    "Charisma's token list has no asset name for %@, so it can't be sent safely.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Token-Liste von Charisma hat keinen Asset-Namen für %@, daher kann dieses Token nicht sicher gesendet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de tokens de Charisma no tiene nombre de activo para %@, así que no se puede enviar de forma segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste de jetons de Charisma n’a pas de nom d’actif pour %@, ce jeton ne peut donc pas être envoyé en toute sécurité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Charisma のトークンリストに %@ のアセット名がないため、安全に送金できません。"
