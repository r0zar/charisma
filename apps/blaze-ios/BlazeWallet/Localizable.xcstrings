    "Turning off this iPhone's passcode removed the wallet from it. Import your seed phrase to restore it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch das Ausschalten des Codes dieses iPhone wurde die Wallet entfernt. Importiere deine Seed-Phrase, um sie wiederherzustellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al desactivar el código de este iPhone se eliminó la billetera. Importa tu frase semilla para restaurarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La désactivation du code de cet iPhone a supprimé le portefeuille. Importez votre phrase de récupération pour le restaurer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone のパスコードをオフにしたため、ウォレットが削除されました。シードフレーズをインポートして復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone의 암호를 끄면서 지갑이 삭제되었습니다. 시드 문구를 가져와 복원하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativar o código deste iPhone removeu a carteira. Importe sua frase de recuperação para restaurá-la."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone'un parolası kapatıldığı için cüzdan kaldırıldı. Geri yüklemek için kurtarma ifadenizi içe aktarın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭此 iPhone 的密码后，钱包已被移除。导入你的助记词即可恢复。"
          }
        }
      }
    },
    "Type these words from what you wrote down.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib diese Wörter so ein, wie du sie notiert hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe estas palabras a partir de lo que anotaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez ces mots d’après ce que vous avez noté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き留めた内容を見て、次の単語を入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적어 둔 내용을 보고 아래 단어를 입력하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite estas palavras a partir do que você anotou."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kelimeleri yazdıklarınıza bakarak girin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请根据你抄下的内容输入这些单词。"
          }
        }
      }
    },
    "Unlink": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trennen"
          }
        },
        "es": {
