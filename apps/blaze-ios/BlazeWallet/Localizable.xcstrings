    "Sends use your %@ %@ on Standard. Your %@ on Blaze stays in its subnet; move it with Charisma Swap.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Senden wird dein Standard-Guthaben von %1$@ %2$@ verwendet. Dein Guthaben von %3$@ auf Blaze bleibt in seinem Subnetz; verschiebe es mit Charisma Swap."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Sends use your %1$@ %2$@ on Standard. Your %3$@ on Blaze stays in its subnet; move it with Charisma Swap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los envíos usan tu saldo Estándar de %@ %@. Tu saldo de %@ en Blaze se queda en su subred; muévelo con Charisma Swap."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les envois utilisent votre solde Standard de %1$@ %2$@. Votre solde de %3$@ sur Blaze reste dans son sous-réseau ; déplacez-le avec Charisma Swap."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送金にはスタンダードの %1$@ %2$@ が使われます。Blaze 上の %3$@ はそのサブネットに残ります。Charisma Swap で移動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내기에는 일반 잔액(%1$@ %2$@)이 사용됩니다. Blaze에 있는 잔액(%3$@)은 해당 서브넷에 그대로 남습니다. Charisma Swap을 사용해 옮기세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os envios usam seu saldo Padrão de %@ %@. Seu saldo de %@ no Blaze fica na própria sub-rede; mova-o com Charisma Swap."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderirken Standart bakiyenizdeki %1$@ %2$@ kullanılır. Blaze'deki %3$@ kendi alt ağında kalır; Charisma Swap ile taşıyın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送使用的是你标准余额中的 %1$@ %2$@。你在 Blaze 上的 %3$@ 会留在其子网中；可使用 Charisma Swap 转移。"
          }
        }
      }
    },
    "Set a passcode on this iPhone to use Blaze Wallet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege auf diesem iPhone einen Code fest, um Blaze Wallet zu verwenden."
          }
