    "Word %@ doesn't match. Check what you wrote down.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wort %@ stimmt nicht überein. Prüfe, was du notiert hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La palabra %@ no coincide. Revisa lo que anotaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot %@ ne correspond pas. Vérifiez ce que vous avez noté."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単語 %@ が一致しません。書き留めた内容を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일치하지 않는 단어: %@. 적어 둔 내용을 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A palavra %@ não corresponde. Confira o que você anotou."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleşmeyen kelime: %@. Yazdıklarınızı kontrol edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单词 %@ 不匹配。请检查你抄下的内容。"
          }
        }
      }
    },
    "Write these down": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Notiere diese Wörter"
          }
        },
        "es": {
