        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charisma'nın token listesinde %@ için varlık adı yok, bu yüzden güvenle gönderilemez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Charisma 代币列表中没有 %@ 的资产名称，因此无法安全发送。"
          }
        }
      }
    },
    "Charisma's token list is unavailable, so tokens can't be checked against its block list.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Token-Liste von Charisma ist nicht verfügbar, daher können Tokens nicht mit der Sperrliste von Charisma abgeglichen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de tokens de Charisma no está disponible, así que no se puede verificar si los tokens están en su lista de bloqueo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste de jetons de Charisma est indisponible, les jetons ne peuvent donc pas être comparés à sa liste de blocage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Charisma のトークンリストを利用できないため、トークンをブロックリストと照合できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Charisma 토큰 목록을 사용할 수 없어 토큰을 차단 목록과 대조할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista de tokens da Charisma está indisponível, então não é possível verificar se os tokens estão na lista de bloqueio dela."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charisma'nın token listesi kullanılamıyor, bu yüzden tokenlar engelleme listesine göre kontrol edilemiyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Charisma 代币列表不可用，因此无法对照其屏蔽列表检查代币。"
          }
        }
      }
    },
    "Charisma's token list sent something Blaze Wallet can't read.": {
      "localizations": {
        "de": {
