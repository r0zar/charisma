        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンク解除"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 해제"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desvincular"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantıyı kaldır"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消关联"
          }
        }
      }
    },
    "Unlink this seed phrase from this iPhone?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Seed-Phrase von diesem iPhone trennen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Desvincular esta frase semilla de este iPhone?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dissocier cette phrase de récupération de cet iPhone ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone からこのシードフレーズのリンクを解除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에서 이 시드 문구를 연결 해제하겠습니까?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desvincular esta frase de recuperação deste iPhone?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kurtarma ifadesinin bu iPhone ile bağlantısı kaldırılsın mı?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要将此助记词与此 iPhone 取消关联吗？"
          }
        }
      }
    },
    "Unlink this wallet from this iPhone?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Wallet von diesem iPhone trennen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Desvincular esta billetera de este iPhone?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dissocier ce portefeuille de cet iPhone ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone からこのウォレットのリンクを解除しますか？"
          }
