          }
        }
      }
    },
    "That's more than one send can carry. Send it in parts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist mehr, als auf einmal gesendet werden kann. Sende den Betrag in mehreren Teilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es más de lo que cabe en un solo envío. Envíalo en partes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est plus qu’un seul envoi ne peut contenir. Envoyez-le en plusieurs fois."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 回で送金できる数量を超えています。分けて送金してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번에 보낼 수 있는 수량을 넘습니다. 여러 번에 나눠 보내세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É mais do que um único envio pode levar. Envie em partes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, tek seferde gönderilebilecek miktardan fazla. Parçalara bölerek gönderin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超出了单笔发送的上限。请分几次发送。"
          }
        }
      }
    },
    "That's more than you have.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist mehr, als du hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es más de lo que tienes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est plus que ce que vous avez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残高を超えています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잔액보다 많습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É mais do que você tem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, sahip olduğunuzdan fazla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超出了你的余额。"
          }
        }
      }
    },
    "The Stacks network didn't answer (%lld).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Stacks-Netzwerk hat nicht geantwortet (%lld)."
