    },
    "The Stacks network sent something Blaze Wallet can't read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Stacks-Netzwerk hat Daten gesendet, die Blaze Wallet nicht lesen kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La red de Stacks envió algo que Blaze Wallet no puede leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le réseau Stacks a envoyé des données que Blaze Wallet ne peut pas lire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Stacks ネットワークから、Blaze Wallet が読み取れないデータが届きました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Stacks 네트워크에서 Blaze Wallet이 읽을 수 없는 데이터를 받았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A rede Stacks enviou algo que a Blaze Wallet não consegue ler."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stacks ağı, Blaze Wallet tarafından okunamayan bir yanıt gönderdi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Stacks 网络返回了 Blaze Wallet 无法读取的内容。"
          }
        }
      }
    },
    "The amount must be more than zero.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Betrag muss größer als null sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cantidad debe ser mayor que cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le montant doit être supérieur à zéro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数量は 0 より大きくしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수량은 0보다 커야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A quantidade deve ser maior que zero."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Miktar sıfırdan büyük olmalı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数量必须大于零。"
          }
        }
      }
    },
    "The network rejected the transfer: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Netzwerk hat die Transaktion abgelehnt: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La red rechazó la transferencia: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le réseau a refusé le transfert : %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークが送金を拒否しました：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크가 전송을 거부했습니다: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A rede rejeitou a transferência: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağ, transferi reddetti: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络拒绝了这笔转账：%@"
          }
        }
      }
    },
    "The wallet is locked. Unlock it to continue.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wallet ist gesperrt. Entsperre sie, um fortzufahren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La billetera está bloqueada. Desbloquéala para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le portefeuille est verrouillé. Déverrouillez-le pour continuer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレットはロックされています。続けるにはロックを解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지갑이 잠겨 있습니다. 계속하려면 잠금을 해제하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A carteira está bloqueada. Desbloqueie-a para continuar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cüzdan kilitli. Devam etmek için kilidini açın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钱包已锁定。请解锁以继续。"
          }
        }
      }
    },
    "The wallet saved on this iPhone can't be read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die auf diesem iPhone gespeicherte Wallet kann nicht gelesen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede leer la billetera guardada en este iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire le portefeuille enregistré sur cet iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone に保存されたウォレットを読み込めません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에 저장된 지갑을 읽을 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível ler a carteira salva neste iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone'da kayıtlı cüzdan okunamıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取此 iPhone 上保存的钱包。"
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Design"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Thème"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "테마"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题"
          }
        }
      }
    },
    "These 24 words are the only way to recover this wallet. Anyone who sees them controls your funds, and Blaze Wallet can't recover them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese 24 Wörter sind der einzige Weg, diese Wallet wiederherzustellen. Wer sie sieht, hat die Kontrolle über dein Guthaben, und Blaze Wallet kann die Wörter nicht wiederherstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas 24 palabras son la única forma de recuperar esta billetera. Cualquiera que las vea controla tus fondos, y Blaze Wallet no puede recuperarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces 24 mots sont le seul moyen de récupérer ce portefeuille. Toute personne qui les voit a le contrôle de vos fonds, et Blaze Wallet ne peut pas récupérer ces mots."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この 24 単語は、このウォレットを復元する唯一の手段です。これらの単語を見た人は誰でも、あなたの資金を自由に動かせます。また、Blaze Wallet はこれらの単語を復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 24개 단어는 이 지갑을 복구할 수 있는 유일한 방법입니다. 이 단어를 보는 사람은 누구나 자금을 마음대로 움직일 수 있으며, Blaze Wallet은 이 단어를 복구할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas 24 palavras são a única forma de recuperar esta carteira. Qualquer pessoa que as veja controla seus fundos, e a Blaze Wallet não pode recuperá-las."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu 24 kelime, bu cüzdanı kurtarmanın tek yoludur. Onları gören herkes fonlarınızın kontrolünü ele geçirir ve Blaze Wallet onları geri getiremez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这 24 个单词是恢复此钱包的唯一方式。任何看到它们的人都能控制你的资金，而且 Blaze Wallet 无法找回它们。"
          }
        }
      }
    },
    "This iPhone couldn't make random words. Try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses iPhone konnte keine zufälligen Wörter erzeugen. Versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone no pudo generar palabras aleatorias. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet iPhone n’a pas pu générer de mots aléatoires. Réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone でランダムな単語を生成できませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에서 무작위 단어를 만들지 못했습니다. 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este iPhone não conseguiu gerar palavras aleatórias. Tente novamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone rastgele kelime oluşturamadı. Tekrar deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iPhone 无法生成随机单词。请重试。"
          }
        }
      }
    },
    "This iPhone's Keychain refused (%@).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüsselbund dieses iPhone hat die Anfrage abgelehnt (%@)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Llavero de este iPhone rechazó la operación (%@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le trousseau de cet iPhone a refusé la demande (%@)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone のキーチェーンが要求を拒否しました（%@）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone의 키체인이 요청을 거부했습니다(%@)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As Chaves deste iPhone recusaram a operação (%@)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iPhone'un Anahtar Zinciri isteği reddetti (%@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 iPhone 的钥匙串拒绝了请求（%@）。"
          }
        }
      }
    },
